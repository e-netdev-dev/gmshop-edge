{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmshop-edge",
	"main": "src/server-entry.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"placement": { "mode": "smart" },
	"observability": { "enabled": true },
	"cache": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gmshop-edge",
			"migrations_dir": "drizzle","database_id": "e75de966-3a54-499f-9a01-360f26b96e33"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "gmshop-edge-files","preview_bucket_name": "gmshop-edge-files" }],
	"send_email": [{ "name": "EMAIL" }],
	"kv_namespaces": [
		{ "binding": "CACHE","id": "26e746bba8dd4abb9beb5435dcf9439a" }
	],
	"queues": {
		"producers": [
			{ "binding": "COMMERCE_QUEUE", "queue": "gmshop-edge-commerce" }
		],
		"consumers": [
			{
				"queue": "gmshop-edge-commerce",
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_concurrency": 4,
				"max_retries": 8,
				"retry_delay": 15,
				"dead_letter_queue": "gmshop-edge-commerce-dlq"
			}
		]
	},
	"triggers": { "crons": ["* * * * *"] }
}
